# Database
DATABASE_URL="postgresql://postgres:admin@localhost:5432/tvs?schema=public"

# Better Auth
BETTER_AUTH_SECRET="dev-change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Encryption for Klambo and Infobip secrets (Paramètres d'une succursale)
ENCRYPTION_SECRET="dev-encryption-secret-change-me"

# KlamboWhatsapp — valeurs par défaut du formulaire (clé API = Paramètres)
# Console : https://whatsapp.klambocore.com/
KLAMBO_BASE_URL="https://whatsapp-api.klambocore.com"
KLAMBO_DEFAULT_COUNTRY="CD"

# App
# Nom produit éventuel. Le nom visible d'un client vient de l'organisation
# et de la succursale en base, pas de cette variable.
# L'inscription publique est fermée : un membre est créé depuis Équipe,
# et ses identifiants partent par email (SMTP).
# SMS Infobip : une clé API, une URL de base et un expéditeur par organisation
# (Paramètres → SMS, clé chiffrée en base). WhatsApp reste sur Klambo.
# Guide : https://portal.infobip.com/onboarding-guide
NEXT_PUBLIC_APP_NAME="TVS Motors"
NEXT_PUBLIC_APP_SITE_URL="https://www.tvsrdcongo.com/"
NEXT_PUBLIC_APP_PRODUCTS_URL="https://www.tvsrdcongo.com/"
NEXT_PUBLIC_APP_CREDIT_URL="https://www.tvsrdcongo.com/"

# SMTP — même boîte que Eteyelo (mot de passe dans .env, pas ici)
# Si le mot de passe contient $, écrivez \$ : Next.js développe $VAR dans .env.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@klambocore.com"
SMTP_PASS=""
SMTP_FROM="Campagnes <contact@klambocore.com>"

# Médias locaux (comme Eteyelo → eteyelo-uploads)
# Windows :
UPLOAD_DIR=C:/api-uploads
# Linux prod :
#UPLOAD_DIR=/var/www/api-uploads
# Adresse https qui sert ce dossier. Infobip télécharge l'image du modèle ici.
# Sur le VPS, UPLOAD_DIR=/var/www/api-uploads et cette origine est le site public.
MEDIA_PUBLIC_BASE_URL="https://campagn.klambocore.com"
# L'API Klambo reçoit une copie via POST /v1/media (son propre UPLOAD_DIR).
